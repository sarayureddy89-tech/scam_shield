# Copy to .env and adjust as needed.

# SQLite by default — zero setup, file-based, perfect for a demo.
# For production, point this at Postgres instead, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/scamshield
DATABASE_URL=sqlite:///./scamshield.db

# Change this in any real deployment.
JWT_SECRET=scamshield-dev-secret-change-in-production
